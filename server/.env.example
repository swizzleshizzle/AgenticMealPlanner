DATABASE_URL="postgresql://mealplanner:mealplanner@localhost:5433/mealplanner?schema=public"

# Port the API listens on. The Vite dev proxy (client/vite.config.ts) targets 3100.
# PORT=3100

# Optional — Google Calendar sync
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/callback

# Optional — AI features.
# By default the Claude Agent SDK reads ~/.claude/.credentials.json (run `claude login` once).
# Set this only if you'd rather authenticate with an API key. Usage is billed to this key.
# ANTHROPIC_API_KEY=sk-ant-...
